        <mxCell id="2" value="4. Масштабирование. API Gateway и Consul" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="30" y="16" width="1000" height="34" as="geometry"/></mxCell>
